FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-uno libreoffice-writer libreoffice-calc libreoffice-impress fonts-liberation fonts-dejavu-core python3-pip tesseract-ocr tesseract-ocr-ara tesseract-ocr-eng tzdata gcc libc6-dev && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages --no-cache-dir pdf2docx openpyxl==3.1.5 onnxruntime==1.23.2 Pillow==12.3.0 numpy==2.2.6 opencv-python-headless==4.12.0.88
RUN mkdir -p /app && python3 -c "import urllib.request; urllib.request.urlretrieve('https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2netp.onnx','/app/u2netp.onnx')"
RUN echo '309c8469258dda742793dce0ebea8e6dd393174f89934733ecc8b14c76f4ddd8  /app/u2netp.onnx' | sha256sum -c -
RUN echo  | base64 -d > /app/U2NET-LICENSE
WORKDIR /app
RUN echo  | base64 -d > /app/app.py
RUN echo  | base64 -d > /app/worker.py
RUN echo  | base64 -d > /app/blocknet.c
RUN gcc -shared -fPIC -o /app/blocknet.so /app/blocknet.c -ldl && useradd -m converter && chown -R converter:converter /app
RUN echo  | base64 -d > /app/pdf_worker.py
RUN echo  | base64 -d > /app/image_worker.py
RUN echo  | base64 -d > /app/table_worker.py
RUN echo  | base64 -d > /app/scan_worker.py
RUN echo  | base64 -d > /app/world_lookup.py
RUN echo  | base64 -d > /app/build_world.py
RUN echo  | base64 -d > /app/clock-countries.json
RUN python3 -c "import urllib.request; urllib.request.urlretrieve('https://download.geonames.org/export/dump/allCountries.zip','/app/allCountries.zip')" && echo '00ddd49c2005d4a8d4050f62915d75b53b74e4a1db40e2edfa8e0803e5777106  /app/allCountries.zip' | sha256sum -c -
RUN python3 /app/build_world.py && rm /app/allCountries.zip && chmod 644 /app/places.sqlite
RUN python3 -c "import urllib.request; urllib.request.urlretrieve('https://raw.githubusercontent.com/tesseract-ocr/tessdata_best/main/ara.traineddata','/usr/share/tesseract-ocr/5/tessdata/ara.traineddata')"
USER converter
ENV PYTHONUNBUFFERED=1
CMD ["python3","/app/app.py"]
